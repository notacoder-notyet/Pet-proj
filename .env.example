# Токен от @BotFather / Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:replace_me

# Базовый URL API. Пусто = бот вызывает модель локально.
# API base URL. Empty = bot calls the model locally.
API_URL=http://127.0.0.1:8000

# Куда слать копии репортов /report. Пусто = только в SQLite.
# Numeric Telegram chat id for /report copies. Empty = SQLite only.
TELEGRAM_ADMIN_CHAT_ID=
