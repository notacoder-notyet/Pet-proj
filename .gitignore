# Virtual environment / Виртуальное окружение
venv/
.venv/
env/

# Python cache / Кэш Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter / Jupyter
.ipynb_checkpoints/

# Large raw data files / Большие исходные данные
data/raw/*.csv

# Secrets / Секреты
.env
.cursor/mcp.json

# Логи бота / Bot logs
logs/*.jsonl
logs/*.db
logs/*.sqlite*

# IDE / Редакторы
.idea/
.vscode/
.cursor/
*.swp
*.swo

# OS / Системные файлы
.DS_Store
Thumbs.db

# Distribution / Сборка
dist/
build/
*.egg-info/
